# ===== 数据库 =====
# 这是 MySQL root 密码，请改成强密码（同时会被后端使用）
MYSQL_ROOT_PASSWORD=请改成强密码

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=请改成强密码

# 图片公网访问地址（很重要，必须能被浏览器访问到）
# 走 nginx 同域名反代（/minio 路径），与网站同 HTTPS，不需要给 MinIO 单独配证书
MINIO_ENDPOINT=https://liliyuan.top/minio
# 后端上传时直连容器内部的 MinIO（一般不用改）
UPLOAD_MINIO_ENDPOINT=http://minio:9000

# ===== JWT 密钥（必须改，后端签名用）=====
JWT_SECRET=请改成一段足够长的随机字符串

# ===== 站点地址 =====
WEBSITE_URL=https://liliyuan.top

# ===== QQ 登录（暂未申请，先保持占位；申请后替换）=====
QQ_APP_ID=100000000
